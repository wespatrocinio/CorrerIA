{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "steps": {
    "install": {
      "commands": ["pip install -r requirements.txt"]
    },
    "playwright": {
      "inputs": [{ "step": "install" }],
      "commands": [
        {
          "cmd": "python -m playwright install --with-deps chromium",
          "customName": "Install Playwright Chromium + system deps"
        }
      ]
    }
  },
  "deploy": {
    "inputs": [{ "step": "playwright" }],
    "startCommand": "uvicorn app.main:app --host 0.0.0.0 --port $PORT"
  }
}
